{
  "manifest_version": 3,
  "name": "PinScout: Out of Stock & Pincode Delivery Finder India",
  "short_name": "PinScout",
  "version": "1.0.2",
  "description": "Out of stock or not deliverable to your pincode? Find nearby pincodes, your state or anywhere in India where it can be delivered.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.amazon.in/*",
    "https://*.blinkit.com/*",
    "https://*.croma.com/*",
    "https://*.flipkart.com/*",
    "https://*.myntra.com/*",
    "https://*.reliancedigital.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "PinScout",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}

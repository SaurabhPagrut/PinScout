{
  "name": "pinscout",
  "version": "1.0.3",
  "private": true,
  "description": "PinScout: finds where an out-of-stock or undeliverable product can be delivered in India (browser extension)",
  "scripts": {
    "test": "node scripts/lint.mjs && node tests/run.js",
    "test:changed": "node tests/run.js --changed",
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build.mjs",
    "site": "node scripts/site.mjs",
    "lint:firefox": "npx --yes web-ext@8 lint -s dist/firefox/pinscout-firefox-$(node -p \"require('./package.json').version\")",
    "plan": "node scripts/plan.js",
    "browse": "node scripts/browse.js",
    "fixture": "node tools/make-fixture.js"
  }
}
